{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes new key exchange algorithms based on Elliptic Curve Cryptography (ECC) for the Transport Layer Security (TLS) protocol.  In particular, it specifies the use of Elliptic Curve Diffie-Hellman (ECDH) key agreement in a TLS handshake and the use of Elliptic Curve Digital Signature Algorithm (ECDSA) as a new authentication mechanism.  This memo provides information for the Internet community.", "ad": "/api/v1/person/person/5376/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126417, "intended_std_level": null, "keywords": "['ecdh', 'elliptic curve diffie-hellman', 'elliptic curve digital signature algorithm', 'ecdsa']", "name": "rfc4492", "note": "", "notify": "", "pages": 35, "resource_uri": "/api/v1/doc/document/rfc4492/", "rev": "", "rfc": "4492", "rfc_number": 4492, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:30:25Z", "title": "Elliptic Curve Cryptography (ECC) Cipher Suites for Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 8397}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies Version 1.2 of the Transport Layer Security (TLS) protocol.  The TLS protocol provides communications security over the Internet.  The protocol allows client/server applications to communicate in a way that is designed to prevent eavesdropping, tampering, or message forgery. [STANDARDS-TRACK]", "ad": "/api/v1/person/person/19790/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 127142, "intended_std_level": null, "keywords": "['idea', 'international data algorithm', 'symmetric', 'transport protocol layer', 'authentication', 'privacy']", "name": "rfc5246", "note": "", "notify": "", "pages": 104, "resource_uri": "/api/v1/doc/document/rfc5246/", "rev": "", "rfc": "5246", "rfc_number": 5246, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:32:39Z", "title": "The Transport Layer Security (TLS) Protocol Version 1.2", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 26785}]}
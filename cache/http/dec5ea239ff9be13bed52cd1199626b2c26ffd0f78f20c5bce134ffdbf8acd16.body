{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "   This document presents a number of problems encountered when\r\n   implementing TLS 1.0, TLS 1.1 and TLS Extensions for clients, and\r\n   their consequences.  The problems include servers that refuse to\r\n   connect with clients supporting newer versions of the protocol, or\r\n   that do not handle such negotiation properly.  Another problem\r\n   encountered is the incorrect use of values in the protocol messages.\r\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-interoperability/", "expires": "2007-04-21T07:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 137093, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-interoperability", "note": "", "notify": "", "pages": 30, "resource_uri": "/api/v1/doc/dochistory/137093/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2006-10-18T07:00:00Z", "title": "Clientside interoperability experiences for the SSL and TLS protocols", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies version 1.3 of the Datagram Transport Layer Security (DTLS) protocol. DTLS 1.3 allows client/server applications to communicate over the Internet in a way that is designed to prevent eavesdropping, tampering, and message forgery.\n\n The DTLS 1.3 protocol is based on the Transport Layer Security (TLS) 1.3 protocol and provides equivalent security guarantees with the exception of order protection / non-replayability. Datagram semantics of the underlying transport are preserved by the DTLS protocol.\n\n This document obsoletes RFC 6347.", "ad": "/api/v1/person/person/115214/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130948, "intended_std_level": null, "keywords": "['Communication Security']", "name": "rfc9147", "note": "", "notify": "", "pages": 61, "resource_uri": "/api/v1/doc/document/rfc9147/", "rev": "", "rfc": "9147", "rfc_number": 9147, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:43:27Z", "title": "The Datagram Transport Layer Security (DTLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 9240}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document requires that Transport Layer Security (TLS) clients and servers never negotiate the use of RC4 cipher suites when they establish connections.  This applies to all TLS versions.  This document updates RFCs 5246, 4346, and 2246.", "ad": "/api/v1/person/person/19177/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129290, "intended_std_level": null, "keywords": "['TLS', 'transport layer security']", "name": "rfc7465", "note": "", "notify": "", "pages": 6, "resource_uri": "/api/v1/doc/document/rfc7465/", "rev": "", "rfc": "7465", "rfc_number": 7465, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:38:44Z", "title": "Prohibiting RC4 Cipher Suites", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1114}]}
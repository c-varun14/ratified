{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "TLS session tickets enable stateless connection resumption for clients without server-side, per-client state.  Servers vend an arbitrary number of session tickets to clients, at their discretion, upon connection establishment.  Clients store and use tickets when resuming future connections.  This document describes a mechanism by which clients can specify the desired number of tickets needed for future connections.  This extension aims to provide a means for servers to determine the number of tickets to generate in order to reduce ticket waste while simultaneously priming clients for future connection attempts.", "ad": "/api/v1/person/person/115214/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130950, "intended_std_level": null, "keywords": "['TLS', 'Tickets']", "name": "rfc9149", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/document/rfc9149/", "rev": "", "rfc": "9149", "rfc_number": 9149, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:43:10Z", "title": "TLS Ticket Requests", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
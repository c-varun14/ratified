otify": "draft-ietf-tls-session-hash@ietf.org, tls-chairs@ietf.org, draft-ietf-tls-session-hash.shepherd@ietf.org, turners@ieca.com, draft-ietf-tls-session-hash.ad@ietf.org", "pages": 15, "resource_uri": "/api/v1/doc/dochistory/81009/", "rev": "06", "rfc_number": null, "shepherd": "/api/v1/person/email/turners@ieca.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/115/", "/api/v1/doc/state/10/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2015-07-06T21:11:44Z", "title": "Transport Layer Security (TLS) Session Hash and Extended Master Secret Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The Transport Layer Security (TLS) master secret is not\n   cryptographically bound to important session parameters such as the\n   server certificate.  Consequently, it is possible for an active\n   attacker to set up two sessions, one with a client and another with a\n   server, such that the master secrets on the two sessions are the\n   same.  Thereafter, any mechanism that relies on the master secret for\n   authentication, including session resumption, becomes vulnerable to a\n   man-in-the-middle attack, where the attacker can simply forward\n   messages back and forth between the client and server.  This\n   specification defines a TLS extension that contextually binds the\n   master secret to a log of the full handshake that computes it, thus\n   preventing such attacks.\n", "ad": "/api/v1/person/person/19177/", "doc": "/api/v1/doc/document/draft-ietf-tls-session-hash/", "expires": "2016-01-06T12:14:57Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 81034, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-session-hash", "note": "", "notify": "draft-ietf-tls-session-hash@ietf.org, tls-chairs@ietf.org, draft-ietf-tls-session-hash.shepherd@ietf.org, turners@ieca.com
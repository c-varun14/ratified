{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 4}, "objects": [{"abstract": "   TLS 1.3 [I-D.ietf-tls-tls13] specifies a signed Diffie-Hellman\n   exchange modelled after SIGMA [SIGMA].  This design is suitable for\n   endpoints whose certified credential is a signing key, which is the\n   common situation for current TLS servers.  This document describes a\n   mode of TLS 1.3 in which one or both endpoints have a certified DH\n   key which is used to authenticate the exchange.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-semistatic-dh/", "expires": "2020-07-20T14:30:48Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 256851, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-semistatic-dh", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/dochistory/256851/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-01-17T17:11:56Z", "title": "Semi-Static Diffie-Hellman Key Establishment for TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   TLS 1.3 [I-D.ietf-tls-tls13] specifies a signed Diffie-Hellman\n   exchange modelled after SIGMA [SIGMA].  This design is suitable for\n   endpoints whose certified credential is a signing key, which is the\n   common situation for current TLS servers.  This document describes a\n   mode of TLS 1.3 in which one or both endpoints have a certified DH\n   key which is used to authenticate the exchange.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-semistatic-dh/", "expires": "2020-07-20T14:30:48Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 256840, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-semistatic-dh", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/dochistory/256840/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-01-17T15:30:47Z", "title": "Semi-Static Diffie-Hellman Key Establishment for TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   TLS 1.3 [RFC8446] specifies a signed Diffie-Hellman exchange modelled\n   after SIGMA [SIGMA].  This design is suitable for endpoints whose\n   certified credential is a signing key, which is the common situation\n   for current TLS servers.  This document describes a mode of TLS 1.3\n   in which one or both endpoints have a certified DH key which is used\n   to authenticate the exchange.\n\nNote to Readers\n\n   Source for this draft and an issue tracker can be found at\n   https://github.com/ekr/draft-rescorla-tls13-semistatic-dh\n   (https://github.com/ekr/draft-rescorla-tls13-semistatic-dh).\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-semistatic-dh/", "expires": "2020-09-08T22:45:25Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 260391, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-semistatic-dh", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/dochistory/260391/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-03-07T23:45:25Z", "title": "Semi-Static Diffie-Hellman Key Establishment for TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   TLS 1.3 [RFC8446] specifies a signed Diffie-Hellman exchange modelled\n   after SIGMA [SIGMA].  This design is suitable for endpoints whose\n   certified credential is a signing key, which is the common situation\n   for current TLS servers.  This document describes a mode of TLS 1.3\n   in which one or both endpoints have a certified DH key which is used\n   to authenticate the exchange.\n\nNote to Readers\n\n   Source for this draft and an issue tracker can be found at\n   https://github.com/ekr/draft-rescorla-tls13-semistatic-dh\n   (https://github.com/ekr/draft-rescorla-tls13-semistatic-dh).\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-semistatic-dh/", "expires": "2020-09-08T22:45:25Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 271820, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-semistatic-dh", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/dochistory/271820/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-09-08T07:24:31Z", "title": "Semi-Static Diffie-Hellman Key Establishment for TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
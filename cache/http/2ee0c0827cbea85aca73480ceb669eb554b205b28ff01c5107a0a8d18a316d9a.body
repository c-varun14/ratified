{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies a new certificate type and two TLS extensions for exchanging raw public keys in Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS).  The new certificate type allows raw public keys to be used for authentication.", "ad": "/api/v1/person/person/19483/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129077, "intended_std_level": null, "keywords": "['TLS', 'DNSSEC', 'DANE', 'Raw Public Key']", "name": "rfc7250", "note": "Joe Salowey (jsalowey@cisco.com) is the Document Shepherd", "notify": "", "pages": 18, "resource_uri": "/api/v1/doc/document/rfc7250/", "rev": "", "rfc": "7250", "rfc_number": 7250, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:37:57Z", "title": "Using Raw Public Keys in Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 4628}]}
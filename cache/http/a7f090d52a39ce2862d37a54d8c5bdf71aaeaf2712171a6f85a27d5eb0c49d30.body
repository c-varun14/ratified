{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document presents a shared-key authentication mechanism for the TLS protocol.  It is intended to allow TLS clients to authenticate using a secret key (such as a password) shared with either the server or a third-party authentication service.  The security of the secret authentication key is augmented by its integration into the normal SSL/TLS server authentication/key exchange mechanism.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-passauth/", "expires": "1997-05-26T07:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 122427, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-passauth", "note": "", "notify": "", "pages": 5, "resource_uri": "/api/v1/doc/dochistory/122427/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "1996-11-22T08:00:00Z", "title": "Addition of Shared Key Authentication to Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies version 1.3 of the Transport Layer Security (TLS) protocol. TLS allows client/server applications to communicate over the Internet in a way that is designed to prevent eavesdropping, tampering, and message forgery.\n\nThis document obsoletes RFC 8446, which specified TLS 1.3. This document obsoletes RFC 5246 (specifying TLS 1.2) and RFCs 5077, 6961, 7627, and 8422, all of which pertain to TLS 1.2 or earlier, and updates RFCs 5705 and 6066. This document also specifies new requirements for TLS 1.2 implementations.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 158071, "intended_std_level": null, "keywords": "[]", "name": "rfc9846", "note": "", "notify": "", "pages": 137, "resource_uri": "/api/v1/doc/document/rfc9846/", "rev": "", "rfc": "9846", "rfc_number": 9846, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-07-11T16:03:47Z", "title": "The Transport Layer Security (TLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
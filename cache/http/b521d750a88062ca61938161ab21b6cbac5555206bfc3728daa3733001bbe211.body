{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This memo presents a technique for using the Secure Remote Password protocol as an authentication method for the Transport Layer Security protocol.  This memo provides information for the Internet community.", "ad": "/api/v1/person/person/19790/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126958, "intended_std_level": null, "keywords": "['secure remote password protocol', 'transport layer security']", "name": "rfc5054", "note": "", "notify": "", "pages": 24, "resource_uri": "/api/v1/doc/document/rfc5054/", "rev": "", "rfc": "5054", "rfc_number": 5054, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:32:11Z", "title": "Using the Secure Remote Password (SRP) Protocol for TLS Authentication", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 5722}]}
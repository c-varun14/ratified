{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document proposes the addition of new cipher suites to the TLS\r\nprotocol version 1.0 to support the MISTY1 encryption algorithm as a\r\nbulk cipher algorithm.  Major change from the previous version is the\r\naddition of intellectual property section.\r\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-misty1/", "expires": "2001-09-06T07:00:01Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126746, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-misty1", "note": "", "notify": "", "pages": 3, "resource_uri": "/api/v1/doc/dochistory/126746/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2001-03-05T08:00:00Z", "title": "Addition of MISTY1 to TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
vel": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-deprecate-obsolete-kex", "note": "", "notify": "joe@salowey.net", "pages": 23, "resource_uri": "/api/v1/doc/dochistory/441812/", "rev": "08", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/108/", "/api/v1/doc/state/115/", "/api/v1/doc/state/17/", "/api/v1/doc/state/216/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2026-06-09T23:11:22Z", "title": "Deprecating Obsolete Key Exchange Methods in (D)TLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   For (D)TLS 1.2, this document deprecates the use of two key\n   exchanges, namely Diffie-Hellman over a finite field and RSA, and it\n   discourages the use of static elliptic curve Diffie-Hellman cipher\n   suites.\n\n   These prescriptions apply only to (D)TLS 1.2 since (D)TLS 1.0 and TLS\n   1.1 are deprecated by RFC 8996 and (D)TLS 1.3 either does not use the\n   affected algorithms or does not share the relevant configuration\n   options.  (There is no DTLS version 1.1.)\n\n   This document updates RFCs 9325, 4346, 5246, 4162, 6347, 5932, 5288,\n   6209, 6367, 8422, 5289, 5469, 4785, 4279, 5487, 6655, and 7905, to\n   deprecate or discourage - i.e., change to MUST NOT or SHOULD NOT, as\n   listed in Section 5.3, Section 5.2, Section 5.3, Section 5.4, and\n   Section 5.5 - the use of cipher suites using the above key exchange\n   methods in (D)TLS 1.2 connections.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-deprecate-obsolete-kex/", "expires": "2026-07-16T17:28:09Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 442802, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-deprecate-obsolete-kex", "note": "", "notify": "joe
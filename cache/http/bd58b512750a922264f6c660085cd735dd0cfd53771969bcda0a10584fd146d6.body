{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes a means of negotiating the use of the encrypt-then-MAC security mechanism in place of the existing MAC-then-encrypt mechanism in Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS).  The MAC-then-encrypt mechanism has been the subject of a number of security vulnerabilities over a period of many years.", "ad": "/api/v1/person/person/19177/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129192, "intended_std_level": null, "keywords": "[]", "name": "rfc7366", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/document/rfc7366/", "rev": "", "rfc": "7366", "rfc_number": 7366, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:09:15Z", "title": "Encrypt-then-MAC for Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2171}]}
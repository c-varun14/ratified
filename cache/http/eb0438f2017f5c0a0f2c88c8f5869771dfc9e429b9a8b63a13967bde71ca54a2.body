{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies a TLS 1.3 extension that allows TLS clients and servers to authenticate with certificates and provide confidentiality based on encryption with a symmetric key from the usual key agreement algorithm and an external pre-shared key (PSK). This Standards Track RFC obsoletes RFC 8773, which was an Experimental RFC.", "ad": "/api/v1/person/person/113536/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 158198, "intended_std_level": null, "keywords": "['cryptography', 'pre-shared key']", "name": "rfc9973", "note": "", "notify": "", "pages": 13, "resource_uri": "/api/v1/doc/document/rfc9973/", "rev": "", "rfc": "9973", "rfc_number": 9973, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-07-15T23:37:48Z", "title": "TLS 1.3 Extension for Using Certificates with an External Pre-Shared Key", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
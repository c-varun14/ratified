{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "RFC 2712 [KERBTLS] introduced mechanisms for supporting Kerberos \r\n[KERB] authentication within the TLS protocol [TLS].  This document \r\nextends RFC 2712 to support delegation of Kerberos credentials.  In \r\nthis way, a TLS server may obtain a Kerberos service ticket on behalf \r\nof the TLS client.  Thus, a single client identity may be used for \r\nauthentication within a multi-tier architecture.  This draft also \r\nproposes a mechanism for a TLS server to indicate Kerberos-specific \r\ninformation to the client within the certificate request message in \r\nthe initial exchange.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-kerb/", "expires": "2002-05-12T07:00:01Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126876, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-kerb", "note": "", "notify": "", "pages": 0, "resource_uri": "/api/v1/doc/dochistory/126876/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2001-11-08T08:00:00Z", "title": "Kerberos Cipher Suites in Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
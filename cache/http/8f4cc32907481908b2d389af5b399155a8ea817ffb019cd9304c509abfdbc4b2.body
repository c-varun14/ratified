 operators may delegate their own credentials for use in TLS,\n   without breaking compatibility with peers that do not support this\n   specification.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-subcerts/", "expires": "2020-09-10T18:02:46Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 260712, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-subcerts", "note": "", "notify": "", "pages": 16, "resource_uri": "/api/v1/doc/dochistory/260712/", "rev": "07", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-03-09T18:02:46Z", "title": "Delegated Credentials for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The organizational separation between the operator of a TLS endpoint\n   and the certification authority can create limitations.  For example,\n   the lifetime of certificates, how they may be used, and the\n   algorithms they support are ultimately determined by the\n   certification authority.  This document describes a mechanism by\n   which operators may delegate their own credentials for use in TLS,\n   without breaking compatibility with peers that do not support this\n   specification.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-subcerts/", "expires": "2020-09-10T18:02:46Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 262142, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-subcerts", "note": "", "notify": "Joseph Salowey <joe@salowey.net>", "pages": 16, "resource_uri": "/api/v1/doc/dochistory/262142/", "rev": "07", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/sta
ubcerts", "note": "", "notify": "Joseph Salowey <joe@salowey.net>", "pages": 20, "resource_uri": "/api/v1/doc/dochistory/299631/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2022-01-10T23:07:25Z", "title": "Delegated Credentials for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The organizational separation between the operator of a TLS endpoint\n   and the certification authority can create limitations.  For example,\n   the lifetime of certificates, how they may be used, and the\n   algorithms they support are ultimately determined by the\n   certification authority.  This document describes a mechanism by\n   which operators may delegate their own credentials for use in TLS,\n   without breaking compatibility with peers that do not support this\n   specification.\n", "ad": "/api/v1/person/person/115214/", "doc": "/api/v1/doc/document/draft-ietf-tls-subcerts/", "expires": "2022-03-27T16:04:35Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 300471, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-subcerts", "note": "", "notify": "Joseph Salowey <joe@salowey.net>", "pages": 20, "resource_uri": "/api/v1/doc/dochistory/300471/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/need-rev/"], "time": "2022-01-27T03:01:56Z", "title": "Delegated Credentials for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The organizational separation between the operator of a (D)TLS\n   endpoint and the certification authority can create limitations.  For\n   example, the lifetime of certificates, how they may be used, and the\n   algorithms they support are ultimately determined by the\n   certification authority.  This document describes a mechanism to to\n   overcome some of these limitations by enabling operators to delegate\n   their own credentials for use in (D)TLS without breaking\n   compatibility with peers that do not support this specification.\n", "ad": "/api/v1/person/person/115214/", "doc": "/api/v1/doc/document/draft-ietf-tls-subcerts/", "expires": "2022-09-08T16:36:27Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 302718, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-subcerts", "note": "", "notify": "Joseph Salowey <joe@salowey.net>", "pages": 21, "resource_uri": "/api/v1/doc/dochistory/302718/", "rev": "12", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/ad-f-up/"], "time": "2022-03-07T17:36:27Z", "title": "Delegated Credentials for (D)TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The organizational separation between the operator of a (D)TLS\n   endpoint and the certification authority can create limitations.  For\n   example, the lifetime of certificates, how they may be used, and the\n   algorithms they support are ultimately determined by the\n   certification authority.  This document describes a mechanism to to\n   overcome some of these limitations by enabling operators to delegate\n   their own credentials for use in (D)TLS without breaking\n   compatibility with peers that do not support this specification.\n", "ad": "/api/v1/person/person/115214/", "doc": "/api/v1
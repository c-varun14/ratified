{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "To use TLS Encrypted ClientHello (ECH), the client needs to learn the ECH configuration for a server before it attempts a connection to the server.  This specification provides a mechanism for conveying the ECH configuration information via DNS, using a SVCB or HTTPS resource record (RR).", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 154076, "intended_std_level": null, "keywords": "['ech SvcParamKey', 'ech SvcParam', 'ECH', 'SVCB', 'HTTPS Resource Records', 'TLS SNI', 'Encrypted SNI', 'Server Name Indication', 'Encrypted Server Name Indication']", "name": "rfc9848", "note": "", "notify": "", "pages": 9, "resource_uri": "/api/v1/doc/document/rfc9848/", "rev": "", "rfc": "9848", "rfc_number": 9848, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:45:53Z", "title": "Bootstrapping TLS Encrypted ClientHello with DNS Service Bindings", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
ime": "2016-06-07T23:39:08Z", "title": "Transport Layer Security (TLS) Cached Information Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Transport Layer Security (TLS) handshakes often include fairly static\n   information, such as the server certificate and a list of trusted\n   certification authorities (CAs).  This information can be of\n   considerable size, particularly if the server certificate is bundled\n   with a complete certificate chain (i.e., the certificates of\n   intermediate CAs up to the root CA).\n\n   This document defines an extension that allows a TLS client to inform\n   a server of cached information, allowing the server to omit already\n   available information.\n", "ad": "/api/v1/person/person/19177/", "doc": "/api/v1/doc/document/draft-ietf-tls-cached-info/", "expires": "2016-11-12T19:26:56Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 100084, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-cached-info", "note": "", "notify": "", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/100084/", "rev": "23", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/108/", "/api/v1/doc/state/115/", "/api/v1/doc/state/17/", "/api/v1/doc/state/117/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2016-06-08T21:08:13Z", "title": "Transport Layer Security (TLS) Cached Information Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Transport Layer Security (TLS) handshakes often include fairly static\n   information, such as the server certificate and a list of trusted\n   certification authorities (CAs).  This information can be of\n   considerable size, particularly if the server certificate is bundled\n   with a complete certificate chain (i.e., the certificates of\n   intermediate CAs up to the root CA).\n\n   This document defines an extension that allows a TLS client to inform\n   a server of cached information, allowing the server to omit already\n   available information.\n", "ad": "/api/v1/person/person/19177/", "doc": "/api/v1/doc/document/draft-ietf-tls-cached-info/", "expires": "2016-11-12T19:26:56Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 100404, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-cached-info", "note": "", "notify": "", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/100404/", "rev": "23", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/108/", "/api/v1/doc/state/115/", "/api/v1/doc/state/17/", "/api/v1/doc/state/32/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2016-06-08T21:08:13Z", "title": "Transport Layer Security (TLS) Cached Information Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Transport Layer Security (TLS) handshakes often include fairly static\n   information, such as the server certificate and a list of trusted\n   certification authorities (CAs).  This information can be of\n   considerable size, particularly if the server certificate is bundled\n   with a complete certificate chain (i.e., the certificates of\n   intermediate CAs up to the root CA).\n\n   This document defines an extension that allows a TLS client to inform\n   a server of cached information, allowing the server to omit already\n   available information.\n", "ad": "/api/v1/person/person/19177/", "doc": "/api/v1/doc/document/draft-ietf-tls-cached-info/", "expires": "2016-11-12T19:26:56Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 101907, "intended_std_level": "
<div class=3D"gmail_quote" style=3D"direction: ltr; font-family: Aptos, =
Arial, Helvetica, sans-serif; font-size: 12pt;">
<br>
</div>
<div class=3D"gmail_quote" style=3D"direction: ltr; font-family: Aptos, =

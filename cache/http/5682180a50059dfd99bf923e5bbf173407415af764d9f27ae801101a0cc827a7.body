7225, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-dtls13", "note": "", "notify": "Sean Turner <sean@sn3rd.com>", "pages": 71, "resource_uri": "/api/v1/doc/dochistory/287225/", "rev": "43", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/104/", "/api/v1/doc/state/115/", "/api/v1/doc/state/17/", "/api/v1/doc/state/34/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/ref/", "/api/v1/name/doctagname/iana/"], "time": "2021-06-02T21:37:31Z", "title": "The Datagram Transport Layer Security (DTLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": 9240}, {"abstract": "   This document specifies Version 1.3 of the Datagram Transport Layer\n   Security (DTLS) protocol.  DTLS 1.3 allows client/server applications\n   to communicate over the Internet in a way that is designed to prevent\n   eavesdropping, tampering, and message forgery.\n\n   The DTLS 1.3 protocol is intentionally based on the Transport Layer\n   Security (TLS) 1.3 protocol and provides equivalent security\n   guarantees with the exception of order protection/non-replayability.\n   Datagram semantics of the underlying transport are preserved by the\n   DTLS protocol.\n\n   This document obsoletes RFC 6347.\n", "ad": "/api/v1/person/person/115214/", "doc": "/api/v1/doc/document/draft-ietf-tls-dtls13/", "expires": "2021-11-02T02:48:52Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 287438, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-dtls13", "note": "", "notify": "Sean Turner <sean@sn3rd.com>", "pages": 71, "resource_uri": "/api/v1/doc/dochistory/287438/", "rev": "43", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api/v1/doc/state/1/", "/
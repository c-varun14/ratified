{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 85}, "objects": [{"abstract": "   This document specifies Version 1.3 of the Datagram Transport Layer\n   Security (DTLS) protocol.  DTLS 1.3 allows client/server applications\n   to communicate over the Internet in a way that is designed to prevent\n   eavesdropping, tampering, and message forgery.\n\n   The DTLS 1.3 protocol is intentionally based on the Transport Layer\n   Security (TLS) 1.3 protocol and provides equivalent security\n   guarantees.  Datagram semantics of the underlying transport are\n   preserved by the DTLS protocol.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-dtls13/", "expires": "2019-05-10T06:14:07Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 229923, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-dtls13", "note": "", "notify": "Sean Turner <sean@sn3rd.com>", "pages": 51, "resource_uri": "/api/v1/doc/dochistory/229923/", "rev": "30", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/41/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2018-11-07T07:39:51Z", "title": "The Datagram Transport Layer Security (DTLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": 9240}, {"abstract": "   This document specifies Version 1.3 of the Datagram Transport Layer\n   Security (DTLS) protocol.  DTLS 1.3 allows client/server applications\n   to communicate over the Internet in a way that is designed to prevent\n   eavesdropping, tampering, and message forgery.\n\n   The DTLS 1.3 protocol is intentionally based on the Transport Layer\n   Security (TLS) 1.3 protocol and provides equivalent security\n   guarantees.  Datagram semantics of the underlying transport are\n   preserved by the DTLS protoco
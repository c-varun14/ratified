{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes the Heartbeat Extension for the Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS) protocols.\n\n The Heartbeat Extension provides a new protocol for TLS/DTLS allowing the usage of keep-alive functionality without performing a renegotiation and a basis for path MTU (PMTU) discovery for DTLS. [STANDARDS-TRACK]", "ad": "/api/v1/person/person/19483/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 128370, "intended_std_level": null, "keywords": "['tls/dtls']", "name": "rfc6520", "note": "Joe Salowey (jsalowey@cisco.com) is the document shepherd.", "notify": "", "pages": 9, "resource_uri": "/api/v1/doc/document/rfc6520/", "rev": "", "rfc": "6520", "rfc_number": 6520, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:36:32Z", "title": "Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS) Heartbeat Extension", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2247}]}
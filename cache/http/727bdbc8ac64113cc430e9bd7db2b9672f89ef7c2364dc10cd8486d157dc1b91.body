{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "RFC 4492 describes elliptic curve cipher suites for Transport Layer Security (TLS).  However, all those cipher suites use HMAC-SHA-1 as their Message Authentication Code (MAC) algorithm.  This document describes sixteen new cipher suites for TLS that specify stronger MAC algorithms.  Eight use Hashed Message Authentication Code (HMAC) with SHA-256 or SHA-384, and eight use AES in Galois Counter Mode (GCM).  This memo provides information for the Internet community.", "ad": "/api/v1/person/person/106164/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 127185, "intended_std_level": null, "keywords": "['transport layer security', 'mac algorithm']", "name": "rfc5289", "note": "", "notify": "", "pages": 6, "resource_uri": "/api/v1/doc/document/rfc5289/", "rev": "", "rfc": "5289", "rfc_number": 5289, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:32:50Z", "title": "TLS Elliptic Curve Cipher Suites with SHA-256/384 and AES Galois Counter Mode (GCM)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1577}]}
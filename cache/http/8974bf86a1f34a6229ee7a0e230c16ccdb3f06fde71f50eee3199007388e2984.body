{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document proposes the addition of new cipher suites to the TLS\r\nprotocol 1.0 [TLS] to support SEED and HAS-160.\r\nThe SEED algorithm is 128-bit symmetric block cipher algorithm.\r\n[SEED] The HAS-160 is 160-bit secure hash function, whose block size\r\nis 512 bit. [HAS] Both algorithms are developed in Korea since 1997\r\nfor stronger communication security.  Currently, SEED is widely used\r\nand is the mandatory cipher in banking and stock applications in\r\nKorea.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-seedhas/", "expires": "2001-01-15T08:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126390, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-seedhas", "note": "", "notify": "", "pages": 4, "resource_uri": "/api/v1/doc/dochistory/126390/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2000-07-14T07:00:00Z", "title": "TLS Extension for SEED and HAS-160", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
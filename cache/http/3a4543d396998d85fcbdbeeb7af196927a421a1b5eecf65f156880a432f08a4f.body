wey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/need-rev/"], "time": "2020-10-02T23:44:32Z", "title": "Deprecating MD5 and SHA-1 signature hashes in TLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The MD5 and SHA-1 hashing algorithms are steadily weakening in\n   strength and their deprecation process should begin for their use in\n   TLS 1.2 digital signatures.  However, this document does not\n   deprecate SHA-1 in HMAC for record protection.  This document updates\n   RFC 5246 and RFC 7525.\n", "ad": "/api/v1/person/person/105815/", "doc": "/api/v1/doc/document/draft-ietf-tls-md5-sha1-deprecate/", "expires": "2021-04-12T18:32:08Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 273338, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-md5-sha1-deprecate", "note": "", "notify": "joe@salowey.net", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/273338/", "rev": "04", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/ad-f-up/"], "time": "2020-10-09T18:32:08Z", "title": "Deprecating MD5 and SHA-1 signature hashes in TLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The MD5 and SHA-1 hashing algorithms are steadily weakening in\n   strength and their deprecation process should begin for their use in\n   TLS 1.2 digital signatures.  However, this document does not\n   deprecate SHA-1 in HMAC for record protection.  This document updates\n   RFC 5246 and RFC 7525.\n", "ad": "/api/v1/person/person/105815/", "doc": "/api/v1/doc/document/draft-ietf-tls-md5-sha1-deprecate/", "expires": "2021-04-12T18:32:08Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 273496, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-md5-sha1-deprecate", "note": "", "notify": "joe@salowey.net", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/273496/", "rev": "04", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/14/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-10-14T17:09:57Z", "title": "Deprecating MD5 and SHA-1 signature hashes in TLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The MD5 and SHA-1 hashing algorithms are steadily weakening in\n   strength and their deprecation process should begin for their use in\n   TLS 1.2 digital signatures.  However, this document does not\n   deprecate SHA-1 in HMAC for record protection.  This document updates\n   RFC 5246 and RFC 7525.\n", "ad": "/api/v1/person/person/105815/", "doc": "/api/v1/doc/document/draft-ietf-tls-md5-sha1-deprecate/", "expires": "2021-04-12T18:32:08Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 273501, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-md5-sha1-deprecate", "note": "", "notify": "joe@salowey.net", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/273501/", "rev": "04", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/111/", "/api/v1/doc/state/15/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2020-10-14T18:40:07Z", "title": "Deprecating MD5 and SHA-1 signature hashes in TLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filenam
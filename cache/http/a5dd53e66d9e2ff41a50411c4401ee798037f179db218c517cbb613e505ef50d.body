{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document allocates code points for the use of RSASSA-PKCS1-v1_5 with client certificates in TLS 1.3.  This removes an obstacle for some deployments to migrate to TLS 1.3.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 156426, "intended_std_level": null, "keywords": "[]", "name": "rfc9963", "note": "", "notify": "", "pages": 6, "resource_uri": "/api/v1/doc/document/rfc9963/", "rev": "", "rfc": "9963", "rfc_number": 9963, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:20:21Z", "title": "Legacy RSASSA-PKCS1-v1_5 Code Points for TLS 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
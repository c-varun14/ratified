{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 3}, "objects": [{"abstract": "   The pre-shared key mechanism available in TLS 1.3 is not suitable for\n   usage with low-entropy keys, such as passwords entered by users.\n   This document describes an extension that enables the use of\n   password-authenticated key exchange protocols with TLS 1.3.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-pake/", "expires": "2026-03-08T23:15:56Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 401416, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-pake", "note": "", "notify": "", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/401416/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-09-04T23:15:56Z", "title": "A Password Authenticated Key Exchange Extension for TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   The pre-shared key mechanism available in TLS 1.3 is not suitable for\n   usage with low-entropy keys, such as passwords entered by users.\n   This document describes an extension that enables the use of\n   password-authenticated key exchange protocols with TLS 1.3.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-pake/", "expires": "2026-09-03T21:47:32Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 415373, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-pake", "note": "", "notify": "", "pages": 18, "resource_uri": "/api/v1/doc/dochistory/415373/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2026-03-02T21:47:32Z", "tit
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document defines a group of new TLS cipher suites that utilize \r\nthe NTRU encryption algorithm and the NSS signature algorithm.  \r\nThese cipher suites are designed to maximize computational \r\nefficiency on both the client and server sides and ease deployment \r\nof the TLS protocol on constrained and embedded devices.  The \r\ndocument assumes the reader is familiar with the TLS protocol.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ntru/", "expires": "2002-01-07T08:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 128057, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ntru", "note": "", "notify": "", "pages": 15, "resource_uri": "/api/v1/doc/dochistory/128057/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2001-07-06T07:00:00Z", "title": "NTRU Cipher Suites for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document suggests extensions to TLS designed to make TLS more \r\namenable to use within wireless environments. The extensions may be\r\nused by TLS clients and servers. The extensions are backwards\r\ncompatible - communication is possible between TLS 1.0 clients\r\nthat support the extensions and TLS 1.0 servers that do not\r\nsupport the extensions, and vice versa.\r\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-wireless/", "expires": "2001-05-25T07:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 127125, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-wireless", "note": "", "notify": "", "pages": 13, "resource_uri": "/api/v1/doc/dochistory/127125/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2000-11-27T08:00:00Z", "title": "Wireless Extensions to TLS\r\n", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document defines the Transport Layer Security (TLS) Certificate Status Version 2 Extension to allow clients to specify and support several certificate status methods. (The use of the Certificate Status extension is commonly referred to as \"OCSP stapling\".) Also defined is a new method based on the Online Certificate Status Protocol (OCSP) that servers can use to provide status information about not only the server's own certificate but also the status of intermediate certificates in the chain.", "ad": "/api/v1/person/person/19483/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 128796, "intended_std_level": null, "keywords": "['RFC 6066', 'RFC 2560', 'RFC 6960', 'RFC 5246', 'OCSP', 'OCSP stapling', 'multi-stapling', 'certificate status checking', 'revocation information', 'status_request', 'status_request_v2']", "name": "rfc6961", "note": "Document Shepherd - Joe Salowey (jsalowey@cisco.com)", "notify": "", "pages": 10, "resource_uri": "/api/v1/doc/document/rfc6961/", "rev": "", "rfc": "6961", "rfc_number": 6961, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:37:18Z", "title": "The Transport Layer Security (TLS) Multiple Certificate Status Request Extension", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2666}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This memo proposes extensions to the Transport Layer Security (TLS) protocol to support the OpenPGP key format.  The extensions discussed here include a certificate type negotiation mechanism, and the required modifications to the TLS Handshake Protocol.  This memo defines an Experimental Protocol for the Internet community.", "ad": "/api/v1/person/person/5376/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126985, "intended_std_level": null, "keywords": "['tls handshake protocol', 'handshake']", "name": "rfc5081", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/document/rfc5081/", "rev": "", "rfc": "5081", "rfc_number": 5081, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/exp/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:31:08Z", "title": "Using OpenPGP Keys for Transport Layer Security (TLS) Authentication", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1851}]}
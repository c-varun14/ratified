{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes GREASE (Generate Random Extensions And Sustain Extensibility), a mechanism to prevent extensibility failures in the TLS ecosystem.  It reserves a set of TLS protocol values that may be advertised to ensure peers correctly handle unknown values.", "ad": "/api/v1/person/person/115214/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130507, "intended_std_level": null, "keywords": "['TLS', 'GREASE']", "name": "rfc8701", "note": "", "notify": "", "pages": 12, "resource_uri": "/api/v1/doc/document/rfc8701/", "rev": "", "rfc": "8701", "rfc_number": 8701, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:42:21Z", "title": "Applying Generate Random Extensions And Sustain Extensibility (GREASE) to TLS Extensibility", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2124}]}
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 5}, "objects": [{"abstract": "   This document specifies an extension to the SSLKEYLOGFILE format to\n   support the logging of information about Encrypted Client Hello (ECH)\n   related secrets.  Two new labels are introduced, namely ECH_SECRET\n   and ECH_CONFIG, which log the Hybrid Public Key Encryption (HPKE)-\n   derived shared secret and the ECHConfig used for the ECH,\n   respectively.\n\n   This extension aims to facilitate debugging of TLS connections\n   employing ECH.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ech-keylogfile/", "expires": "2025-04-06T15:04:02Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 372694, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ech-keylogfile", "note": "", "notify": "", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/372694/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2024-10-03T15:04:02Z", "title": "SSLKEYLOGFILE Extension for Encrypted Client Hello (ECH)", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies an extension to the SSLKEYLOGFILE format to\n   support the logging of information about Encrypted Client Hello (ECH)\n   related secrets.  Two new labels are introduced, namely ECH_SECRET\n   and ECH_CONFIG, which log the Hybrid Public Key Encryption (HPKE)-\n   derived shared secret and the ECHConfig used for the ECH,\n   respectively.\n\n   This extension aims to facilitate debugging of TLS connections\n   employing ECH.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ech-keylogfile/", "expires": "2025-04-06T15:04:02Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 373055, "intended_std_level"
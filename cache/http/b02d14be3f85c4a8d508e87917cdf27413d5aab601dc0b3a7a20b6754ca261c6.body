{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 5}, "objects": [{"abstract": "   An extension is defined for TLS that allows a client and server to\n   detect an attempt to force the use of less-preferred application\n   protocol even where protocol options are incompatible.  This\n   supplements application-layer protocol negotiation (ALPN), which\n   allows choices between compatible protocols to be authenticated.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-snip/", "expires": "2022-02-26T02:46:13Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 292369, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-snip", "note": "", "notify": "", "pages": 12, "resource_uri": "/api/v1/doc/dochistory/292369/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2021-08-25T01:46:13Z", "title": "Secure Negotiation of Incompatible Protocols in TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   An extension is defined for TLS that allows a client and server to\n   detect an attempt to force the use of less-preferred application\n   protocol even where protocol options are incompatible.  This\n   supplements application-layer protocol negotiation (ALPN), which\n   allows choices between compatible protocols to be authenticated.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-snip/", "expires": "2022-02-26T02:46:13Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 292610, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-snip", "note": "", "notify": "", "pages": 12, "resource_uri": "/api/v1/doc/dochistory/292610/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/
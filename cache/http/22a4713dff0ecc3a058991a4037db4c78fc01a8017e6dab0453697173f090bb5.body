{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 54}, "objects": [{"abstract": "   Secure Sockets Layer version 3.0 (SSLv3) [RFC6101] is no longer\n   secure.  This document requires that SSLv3 not be used.  The\n   replacement versions, in particular Transport Layer Security (TLS)\n   1.2 [RFC5246], are considerably more secure and capable protocols.\n\n   This document updates the backward compatibility sections of the TLS\n   RFCs to prohibit fallback to SSLv3.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-sslv3-diediedie/", "expires": "2015-06-12T22:56:35Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 71266, "intended_std_level": "/api/v1/name/intendedstdlevelname/bcp/", "keywords": "[]", "name": "draft-ietf-tls-sslv3-diediedie", "note": "", "notify": "\"Joseph A. Salowey\" <joe@salowey.net>", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/71266/", "rev": "00", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/41/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2015-01-23T19:36:18Z", "title": "Deprecating Secure Sockets Layer Version 3.0", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Secure Sockets Layer version 3.0 (SSLv3) [RFC6101] is no longer\n   secure.  This document requires that SSLv3 not be used.  The\n   replacement versions, in particular Transport Layer Security (TLS)\n   1.2 [RFC5246], are considerably more secure and capable protocols.\n\n   This document updates the backward compatibility sections of the TLS\n   RFCs to prohibit fallback to SSLv3.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-sslv3-diediedie/", "expires": "2015-06-12T22:56:35Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 71262, "intended_std_level": null, "keywords": "[]", "name":
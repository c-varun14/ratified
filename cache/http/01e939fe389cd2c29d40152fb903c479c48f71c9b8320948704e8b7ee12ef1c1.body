{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes the use of the ChaCha stream cipher and Poly1305 authenticator in the Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS) protocols.\n\n This document updates RFCs 5246 and 6347.", "ad": "/api/v1/person/person/19177/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129728, "intended_std_level": null, "keywords": "['AEAD', 'DTLS']", "name": "rfc7905", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/document/rfc7905/", "rev": "", "rfc": "7905", "rfc_number": 7905, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:39:57Z", "title": "ChaCha20-Poly1305 Cipher Suites for Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1802}]}
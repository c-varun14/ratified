{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "The Secure Sockets Layer version 3.0 (SSLv3), as specified in RFC 6101, is not sufficiently secure. This document requires that SSLv3 not be used. The replacement versions, in particular, Transport Layer Security (TLS) 1.2 (RFC 5246), are considerably more secure and capable protocols.\n\n This document updates the backward compatibility section of RFC 5246 and its predecessors to prohibit fallback to SSLv3.", "ad": "/api/v1/person/person/19177/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129391, "intended_std_level": null, "keywords": "['SSL', 'TLS', 'insecure', 'diediedie']", "name": "rfc7568", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/document/rfc7568/", "rev": "", "rfc": "7568", "rfc_number": 7568, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:39:04Z", "title": "Deprecating Secure Sockets Layer Version 3.0", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1650}]}
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 26}, "objects": [{"abstract": "   This document defines the Transport Layer Security (TLS) Certificate\n   Status Version 2 Extension to allow clients to specify and support\n   multiple certificate status methods.  Also defined is a new method\n   based on the Online Certificate Status Protocol (OCSP) that servers\n   can use to provide status information not just about the server's own\n   certificate, but also the status of intermediate certificates in the\n   chain.\n\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-multiple-cert-status-extension/", "expires": "2012-11-10T16:35:13Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 5154, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-multiple-cert-status-extension", "note": "", "notify": "", "pages": 9, "resource_uri": "/api/v1/doc/dochistory/5154/", "rev": "00", "rfc_number": null, "shepherd": "/api/v1/person/email/nomcom-chair@ietf.org/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2012-05-09T15:35:13Z", "title": "The TLS Multiple Certificate Status Request Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document defines the Transport Layer Security (TLS) Certificate\n   Status Version 2 Extension to allow clients to specify and support\n   multiple certificate status methods.  Also defined is a new method\n   that a server can use to provide status information (i.e., based on\n   the Online Certificate Status Protocol and Server-Based Certificate\n   Validation Protocol) not just about the server's own certificate, but\n   also the status of intermediate certificates in the chain.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-multiple-cert-status-extension/", "expires": "2013-01-09T15:07:55Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 9062, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-multiple-cert-status-extension", "note": "", "notify": "", "pages": 10, "resource_uri": "/api/v1/doc/dochistory/9062/", "rev": "01", "rfc_number": null, "shepherd": "/api/v1/person/email/nomcom-chair@ietf.org/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2012-07-08T14:07:55Z", "title": "The TLS Multiple Certificate Status Request Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document defines the Transport Layer Security (TLS) Certificate\n   Status Version 2 Extension to allow clients to specify and support\n   multiple certificate status methods.  Also defined is a new method\n   based on the Online Certificate Status Protocol (OCSP) that servers\n   can use to provide status information not just about the server's own\n   certificate, but also the status of intermediate certificates in the\n   chain.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-multiple-cert-status-extension/", "expires": "2013-04-22T16:11:01Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 11649, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-multiple-cert-status-extension", "note": "", "notify": "", "pages": 9, "resource_uri": "/api/v1/doc/dochistory/11649/", "rev": "02", "rfc_number": null, "shepherd": "/api/v1/person/email/nomcom-chair@ietf.org/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2012-10-19T16:11:00Z", "title": "The TLS Multiple Certificate Status Request Extension", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, 
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "The United States Government has published guidelines for \"NSA Suite\r\n   B Cryptography\" dated July, 2005, which defines cryptographic\r\n   algorithm polcy for national security applications.  This document\r\n   defines a profile of TLS which is conformant with Suite B.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-suiteb/", "expires": "2007-10-25T07:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 137777, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-suiteb", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/dochistory/137777/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/6/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2007-05-03T07:00:00Z", "title": "Suite B Cipher Suites for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 49}, "objects": [{"abstract": "   This document specifies an optional behavior of TLS implementations,\n   dubbed False Start.  It affects only protocol timing, not on-the-wire\n   protocol data, and can be implemented unilaterally.  The TLS False\n   Start feature leads to a latency reduction of one round trip for\n   certain handshakes.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-falsestart/", "expires": "2015-11-08T19:43:19Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 77784, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-falsestart", "note": "", "notify": "", "pages": 11, "resource_uri": "/api/v1/doc/dochistory/77784/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2015-05-07T18:43:19Z", "title": "Transport Layer Security (TLS) False Start", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies an optional behavior of TLS client\n   implementations, dubbed False Start.  It affects only protocol\n   timing, not on-the-wire protocol data, and can be implemented\n   unilaterally.  A TLS False Start reduces handshake latency to one\n   round trip.\n", "ad": "/api/v1/person/person/19177/", "doc": "/api/v1/doc/document/draft-ietf-tls-falsestart/", "expires": "2016-05-05T17:37:06Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 96169, "intended_std_level": "/api/v1/name/intendedstdlevelname/exp/", "keywords": "[]", "name": "draft-ietf-tls-falsestart", "note": "", "notify": "\"Sean Turner\" <sean@sn3rd.com>", "pages": 10, "resource_uri": "/api/v1/doc/dochistory/96169/", "rev": "01", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api
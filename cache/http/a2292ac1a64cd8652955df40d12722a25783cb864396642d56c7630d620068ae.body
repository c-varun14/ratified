{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 37}, "objects": [{"abstract": "   This draft describes a new TLS extension for transport of a DNS\n   record set serialized with the DNSSEC signatures needed to\n   authenticate that record set.  The intent of this proposal is to\n   allow TLS clients to perform DANE authentication of a TLS server\n   certificate without needing to perform additional DNS record lookups.\n   It will typically not be used for general DNSSEC validation of TLS\n   endpoint names.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-dnssec-chain-extension/", "expires": "2016-12-06T22:46:21Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 101306, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-dnssec-chain-extension", "note": "", "notify": "", "pages": 12, "resource_uri": "/api/v1/doc/dochistory/101306/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2016-06-04T21:46:21Z", "title": "A DANE Record and DNSSEC Authentication Chain Extension for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This draft describes a new TLS extension for transport of a DNS\n   record set serialized with the DNSSEC signatures needed to\n   authenticate that record set.  The intent of this proposal is to\n   allow TLS clients to perform DANE authentication of a TLS server\n   certificate without needing to perform additional DNS record lookups.\n   It will typically not be used for general DNSSEC validation of TLS\n   endpoint names.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-dnssec-chain-extension/", "expires": "2017-01-09T04:51:22Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 169648, "intended_std_level": null, "ke
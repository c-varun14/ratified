{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "Hybrid key exchange refers to using multiple key exchange algorithms simultaneously and combining the result with the goal of providing security even if a way is found to defeat the encryption for all but one of the component algorithms. It is motivated by the transition to post-quantum cryptography. This document provides a construction for hybrid key exchange in the Transport Layer Security (TLS) protocol version 1.3.", "ad": "/api/v1/person/person/113536/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 158195, "intended_std_level": null, "keywords": "['Post-Quantum']", "name": "rfc9954", "note": "", "notify": "", "pages": 18, "resource_uri": "/api/v1/doc/document/rfc9954/", "rev": "", "rfc": "9954", "rfc_number": 9954, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-07-15T22:20:38Z", "title": "Hybrid Key Exchange in TLS 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document requires that when Transport Layer Security (TLS) clients and servers establish connections, they never negotiate the use of Secure Sockets Layer (SSL) version 2.0.  This document updates the backward compatibility sections found in the Transport Layer Security (TLS). [STANDARDS-TRACK]", "ad": "/api/v1/person/person/102154/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 128037, "intended_std_level": null, "keywords": "[]", "name": "rfc6176", "note": "", "notify": "", "pages": 4, "resource_uri": "/api/v1/doc/document/rfc6176/", "rev": "", "rfc": "6176", "rfc_number": 6176, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:04:25Z", "title": "Prohibiting Secure Sockets Layer (SSL) Version 2.0", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 959}]}
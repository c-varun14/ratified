{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 2}, "objects": [{"abstract": "   This document specifies Version 1.3 of the Transport Layer Security\n   (TLS) protocol.  The TLS protocol provides communications security\n   over the Internet.  The protocol allows client/server applications to\n   communicate in a way that is designed to prevent eavesdropping,\n   tampering, or message forgery.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-rfc5246-bis/", "expires": "2014-10-19T21:30:27Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 55638, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-rfc5246-bis", "note": "", "notify": "", "pages": 102, "resource_uri": "/api/v1/doc/dochistory/55638/", "rev": "00", "rfc_number": null, "shepherd": "/api/v1/person/email/nomcom-chair@ietf.org/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2014-04-17T21:30:27Z", "title": "The Transport Layer Security (TLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies Version 1.3 of the Transport Layer Security\n   (TLS) protocol.  The TLS protocol provides communications security\n   over the Internet.  The protocol allows client/server applications to\n   communicate in a way that is designed to prevent eavesdropping,\n   tampering, or message forgery.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-rfc5246-bis/", "expires": "2014-10-19T21:30:27Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 158715, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-rfc5246-bis", "note": "", "notify": "", "pages": 102, "resource_uri": "/api/v1/doc/dochistory/158715/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/4/", "
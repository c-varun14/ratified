{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "The TLS Pathsec Protocol (or Pathsec Protocol in short) extends the\r\nTLS protocol into securing data in transit not only between two end\r\npoints, but also between the intermediaries en route, based on TLS\r\n1.0 with appropriate extensions that include injecting source routing\r\npolicies above the Transport layer.\r\n\r\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-pathsec/", "expires": "2002-04-04T08:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 128556, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-pathsec", "note": "", "notify": "", "pages": 50, "resource_uri": "/api/v1/doc/dochistory/128556/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2001-10-05T07:00:00Z", "title": "TLS Pathsec Protocol\r\n", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 55}, "objects": [{"abstract": "   This document specifies version 1.3 of the Transport Layer Security\n   (TLS) protocol.  TLS allows client/server applications to communicate\n   over the Internet in a way that is designed to prevent eavesdropping,\n   tampering, and message forgery.\n\n   This document updates RFCs 5705, 6066, 7627, and 8422 and obsoletes\n   RFCs 5077, 5246, 6961, and 8446.  This document also specifies new\n   requirements for TLS 1.2 implementations.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8446bis/", "expires": "2024-01-08T21:03:37Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 348558, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-rfc8446bis", "note": "", "notify": "caw@heapingbits.net", "pages": 159, "resource_uri": "/api/v1/doc/dochistory/348558/", "rev": "09", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/42/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/rev-wg/"], "time": "2023-12-06T19:27:10Z", "title": "The Transport Layer Security (TLS) Protocol Version 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies version 1.3 of the Transport Layer Security\n   (TLS) protocol.  TLS allows client/server applications to communicate\n   over the Internet in a way that is designed to prevent eavesdropping,\n   tampering, and message forgery.\n\n   This document updates RFCs 5705, 6066, 7627, and 8422 and obsoletes\n   RFCs 5077, 5246, 6961, and 8446.  This document also specifies new\n   requirements for TLS 1.2 implementations.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8446bis/", "expires": "2024-01-08T21:01:11Z", "external_url": "", "group": 
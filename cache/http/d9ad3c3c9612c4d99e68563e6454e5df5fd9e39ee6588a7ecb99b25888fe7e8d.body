me": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-09-13T05:26:20Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 385837, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/385837/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/13/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/ad-f-up/"], "time": "2025-03-12T05:26:20Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-09-13T05:26:20Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 385861, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/385861/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/14/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-03-12T14:10:46Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-09-13T05:26:20Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 385899, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/385899/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/111/", "/api/v1/doc/state/15/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-03-13T04:26:54Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-09-13T05:26:20Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 389399, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/389399/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/114/", "/api/v1/doc/state/15/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-04-08T23:58:37Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-09-13T05:26:20Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 389412, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/389412/", "rev": "11", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/114/", "/api/v1/doc/state/20/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-04-09T07:05:00Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries that do not already have a\n   \"Comments\" column.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-10-13T16:21:46Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 389719, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 19, "resource_uri": "/api/v1/doc/dochistory/389719/", "rev": "12", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/115/", "/api/v1/doc/state/20/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-04-11T16:21:46Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comments\" column to all active registries that do not already have a\n   \"Comments\" column.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-10-13T16:21:46Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 391262, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 19, "resource_uri": "/api/v1/doc/dochistory/391262/", "rev": "12", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/115/", "/api/v1/doc/state/12/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2025-04-30T00:16:20Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document updates the changes to TLS and DTLS IANA registries\n   made in RFC 8447.  It adds a new value \"D\" for discouraged to the\n   Recommended column of the selected TLS registries and adds a\n   \"Comment\" column to all active registries that do not already have a\n   \"Comment\" column.  Finally, it updates the registration request\n   instructions.\n\n   This document updates the following RFCs: 3749, 5077, 4680, 5246,\n   5705, 5878, 6520, 7301, and 8447.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-rfc8447bis/", "expires": "2025-11-30T13:46:07Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 392953, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-rfc8447bis", "note": "", "notify": "durumcrustulum@gmail.com", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/392953/", "rev": "13", "rfc_number": null, "shepherd": "/api/v1/person/email/durumcrustulum@gmail.co
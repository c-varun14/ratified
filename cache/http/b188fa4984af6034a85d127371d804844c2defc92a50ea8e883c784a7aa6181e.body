-10-05T14:36:38Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 440101, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-tls12-frozen", "note": "", "notify": "sean@sn3rd.com", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/440101/", "rev": "08", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/108/", "/api/v1/doc/state/112/", "/api/v1/doc/state/17/", "/api/v1/doc/state/216/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2026-05-20T21:18:33Z", "title": "TLS 1.2 is in Feature Freeze", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Use of TLS 1.3, which fixes some known deficiencies in TLS 1.2, is\n   growing.  This document specifies that outside of urgent security\n   fixes (as determine by TLS WG consensus), new TLS Exporter Labels, or\n   new Application-Layer Protocol Negotiation (ALPN) Protocol IDs, no\n   changes will be approved for TLS 1.2.  This prescription does not\n   pertain to DTLS (in any DTLS version); it pertains to TLS only.\n", "ad": "/api/v1/person/person/112723/", "doc": "/api/v1/doc/document/draft-ietf-tls-tls12-frozen/", "expires": "2025-10-05T14:36:38Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 445560, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-tls12-frozen", "note": "", "notify": "sean@sn3rd.com", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/445560/", "rev": "08", "rfc_number": null, "shepherd": "/api/v1/person/email/sean@sn3rd.com/", "states": ["/api/v1/doc/state/3/", "/api/v1/doc/state/108/", "/api/v1/doc/state/112/", "/api/v1/doc/state/7/", "/api/v1/doc/state/216/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2026-07
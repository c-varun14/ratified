/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2024-07-24T23:42:15Z", "title": "TLS 1.2 is in Feature Freeze", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   TLS 1.2 is in widespread use and can be configured such that it\n   provides good security properties.  TLS 1.3 is also in widespread use\n   and fixes some known deficiencies with TLS 1.2, such as removing\n   error-prone cryptographic primitives and encrypting more of the\n   traffic so that it is not readable by outsiders.\n\n   Both versions have several extension points, so items like new\n   cryptographic algorithms, new supported groups (formerly \"named\n   curves\"), etc., can be added without defining a new protocol.  This\n   document specifies that outside of urgent security fixes, no new\n   features will be approved for TLS 1.2.  This prescription does not\n   pertain to DTLS (in any DTLS version); it pertains to TLS only.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-tls12-frozen/", "expires": "2025-02-21T17:12:39Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 369548, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-tls12-frozen", "note": "", "notify": "", "pages": 5, "resource_uri": "/api/v1/doc/dochistory/369548/", "rev": "02", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2024-08-20T17:12:39Z", "title": "TLS 1.2 is in Feature Freeze", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   TLS 1.2 is in widespread use and can be configured such that it\n   provides good security properties.  TLS 1.3 is also i
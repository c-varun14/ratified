{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "A number of protocols wish to leverage Transport Layer Security (TLS) to perform key establishment but then use some of the keying material for their own purposes.  This document describes a general mechanism for allowing that. [STANDARDS-TRACK]", "ad": "/api/v1/person/person/106164/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 127583, "intended_std_level": null, "keywords": "['key establishment']", "name": "rfc5705", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/document/rfc5705/", "rev": "", "rfc": "5705", "rfc_number": 5705, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:34:14Z", "title": "Keying Material Exporters for Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2302}]}
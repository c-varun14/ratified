{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document builds upon the TLS Protocol Specification [TLS].  The\r\nextensions described herein are intended to apply to Version 1.0 of\r\nthe TLS specification.\r\nThe purpose of this document is to update the TLS protocol with\r\nextensions to support the certificates, public key algorithms,\r\nsymmetric ciphers, hash algorithms, and trust model used by OpenPGP\r\n[OpenPGP].\r\n\r\n   This document uses the same notation used in the TLS Protocol draft.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-openpgp/", "expires": "2002-08-23T07:00:02Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 125644, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-openpgp", "note": "", "notify": "", "pages": 4, "resource_uri": "/api/v1/doc/dochistory/125644/", "rev": "02", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2002-02-19T08:00:00Z", "title": "Extensions to TLS for OpenPGP keys", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
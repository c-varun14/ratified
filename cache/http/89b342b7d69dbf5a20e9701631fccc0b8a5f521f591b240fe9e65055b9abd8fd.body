{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies an optional behavior of Transport Layer Security (TLS) client implementations, dubbed \"False Start\".  It affects only protocol timing, not on-the-wire protocol data, and can be implemented unilaterally.  A TLS False Start reduces handshake latency to one round trip.", "ad": "/api/v1/person/person/19177/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 129740, "intended_std_level": null, "keywords": "[]", "name": "rfc7918", "note": "", "notify": "", "pages": 11, "resource_uri": "/api/v1/doc/document/rfc7918/", "rev": "", "rfc": "7918", "rfc_number": 7918, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:11:54Z", "title": "Transport Layer Security (TLS) False Start", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 3198}]}
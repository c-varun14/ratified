{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes several cipher suites to be used with the \r\nTransport Layer Security (TLS) protocol.  Changes in US export\r\nregulations in 1999 permitted the export of software programs \r\nusing 56-bit data encryption and 1024-bit key exchange.  \r\nThe cipher suites described in this document were designed to take\r\nadvantage of this change in the regulations.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-56-bit-ciphersuites/", "expires": "2002-01-26T08:00:01Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 124819, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-56-bit-ciphersuites", "note": "", "notify": "", "pages": 3, "resource_uri": "/api/v1/doc/dochistory/124819/", "rev": "01", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2001-07-25T07:00:00Z", "title": "56-bit Export Cipher Suites For TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
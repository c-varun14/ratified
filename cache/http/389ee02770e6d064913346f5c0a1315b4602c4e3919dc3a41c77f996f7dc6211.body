", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/154/", "/api/v1/doc/state/112/", "/api/v1/doc/state/9/", "/api/v1/doc/state/44/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": ["/api/v1/name/doctagname/ad-f-up/"], "time": "2021-05-11T10:24:00Z", "title": "Connection Identifiers for DTLS 1.2", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies the Connection ID (CID) construct for the\n   Datagram Transport Layer Security (DTLS) protocol version 1.2.\n\n   A CID is an identifier carried in the record layer header that gives\n   the recipient additional information for selecting the appropriate\n   security association.  In \"classical\" DTLS, selecting a security\n   association of an incoming DTLS record is accomplished with the help\n   of the 5-tuple.  If the source IP address and/or source port changes\n   during the lifetime of an ongoing DTLS session then the receiver will\n   be unable to locate the correct security context.\n\n   The new ciphertext record format with CID also provides content type\n   encryption and record-layer padding.\n", "ad": "/api/v1/person/person/115214/", "doc": "/api/v1/doc/document/draft-ietf-tls-dtls-connection-id/", "expires": "2021-12-24T22:22:11Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 289419, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-tls-dtls-connection-id", "note": "", "notify": "Joseph Salowey <joe@salowey.net>", "pages": 18, "resource_uri": "/api/v1/doc/dochistory/289419/", "rev": "13", "rfc_number": null, "shepherd": "/api/v1/person/email/joe@salowey.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/108/", "/api/v1/doc/state/154/", "/api/v1/doc/state/112/", "/api/v1/doc/state/17/", "/api/v1/doc/state/32/", "/api/v1/doc/state/44/"], "std_level": null, "
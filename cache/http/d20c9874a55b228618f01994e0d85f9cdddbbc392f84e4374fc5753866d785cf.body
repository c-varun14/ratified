{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes a format that supports logging information about the secrets used in a TLS connection. Recording secrets to a file in SSLKEYLOGFILE format allows diagnostic and logging tools that use this file to decrypt messages exchanged by TLS endpoints. This format is intended for use in systems where TLS only protects test data.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 158197, "intended_std_level": null, "keywords": "['network transparency', 'tls', 'blockchain']", "name": "rfc9850", "note": "", "notify": "", "pages": 12, "resource_uri": "/api/v1/doc/document/rfc9850/", "rev": "", "rfc": "9850", "rfc_number": 9850, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-07-15T23:37:41Z", "title": "The SSLKEYLOGFILE Format for TLS", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
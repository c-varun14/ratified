{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document provides specifications for existing TLS extensions.  It is a companion document for RFC 5246, \"The Transport Layer Security (TLS) Protocol Version 1.2\".  The extensions specified are server_name, max_fragment_length, client_certificate_url, trusted_ca_keys, truncated_hmac, and status_request. [STANDARDS-TRACK]", "ad": "/api/v1/person/person/19483/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 127931, "intended_std_level": null, "keywords": "['server_name', 'max_fragment_length', 'client_certificate_url', 'trusted_ca_keys', 'truncated_hmac', 'status_request']", "name": "rfc6066", "note": "Document shepherd is Joe Salowey &lt;jsalowey@cisco.com&gt;", "notify": "", "pages": 25, "resource_uri": "/api/v1/doc/document/rfc6066/", "rev": "", "rfc": "6066", "rfc_number": 6066, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/", "/api/v1/name/doctagname/verified-errata/"], "time": "2026-05-20T15:35:17Z", "title": "Transport Layer Security (TLS) Extensions: Extension Definitions", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 6875}]}
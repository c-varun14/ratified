{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "An extension to Transport Layer Security (TLS) is defined that allows endpoints to negotiate the maximum size of protected records that each will send the other.\n\n This replaces the maximum fragment length extension defined in RFC 6066.", "ad": "/api/v1/person/person/115214/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130266, "intended_std_level": null, "keywords": "['TLS', 'record', 'IoT', 'encryption']", "name": "rfc8449", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/document/rfc8449/", "rev": "", "rfc": "8449", "rfc_number": 8449, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:36:30Z", "title": "Record Size Limit Extension for TLS", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
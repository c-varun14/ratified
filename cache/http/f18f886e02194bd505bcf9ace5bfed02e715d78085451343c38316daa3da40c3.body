{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 3}, "objects": [{"abstract": "   Traditional discrete logarithm-based Diffie-Hellman (DH) key exchange\n   during the TLS handshake suffers from a number of security,\n   interoperability, and efficiency shortcomings.  These shortcomings\n   arise from lack of clarity about which DH group parameters TLS\n   servers should offer and clients should accept.  This document offers\n   a solution to these shortcomings for compatible peers by establishing\n   a registry of DH parameters with known structure and a mechanism for\n   peers to indicate support for these groups.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-negotiated-dl-dhe/", "expires": "2015-01-22T15:37:49Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 61408, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-negotiated-dl-dhe", "note": "", "notify": "", "pages": 19, "resource_uri": "/api/v1/doc/dochistory/61408/", "rev": "00", "rfc_number": null, "shepherd": "/api/v1/person/email/nomcom-chair@ietf.org/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2014-07-21T14:37:49Z", "title": "Negotiated Discrete Log Diffie-Hellman Ephemeral Parameters for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Traditional discrete logarithm-based Diffie-Hellman (DH) key exchange\n   during the TLS handshake suffers from a number of security,\n   interoperability, and efficiency shortcomings.  These shortcomings\n   arise from lack of clarity about which DH group parameters TLS\n   servers should offer and clients should accept.  This document offers\n   a solution to these shortcomings for compatible peers by establishing\n   a registry of DH parameters with known structure and a mechanism for\n   peers to indicate support for these groups.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-negotiated-dl-dhe/", "expires": "2015-01-22T15:37:49Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 74673, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-negotiated-dl-dhe", "note": "", "notify": "", "pages": 19, "resource_uri": "/api/v1/doc/dochistory/74673/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/4/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2014-07-29T14:18:47Z", "title": "Negotiated Discrete Log Diffie-Hellman Ephemeral Parameters for TLS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Traditional discrete logarithm-based Diffie-Hellman (DH) key exchange\n   during the TLS handshake suffers from a number of security,\n   interoperability, and efficiency shortcomings.  These shortcomings\n   arise from lack of clarity about which DH group parameters TLS\n   servers should offer and clients should accept.  This document offers\n   a solution to these shortcomings for compatible peers by establishing\n   a registry of DH parameters with known structure and a mechanism for\n   peers to indicate support for these groups.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-negotiated-dl-dhe/", "expires": "2015-01-22T15:37:49Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 159629, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-negotiated-dl-dhe", "note": "", "notify": "", "pages": 19, "resource_uri": "/api/v1/doc/dochistory/159629/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/4/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2015-03-13T21:08:31Z", "title": "Negotiated Discret
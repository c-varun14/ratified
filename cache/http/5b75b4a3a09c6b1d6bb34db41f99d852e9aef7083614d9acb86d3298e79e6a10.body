{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document updates the changes to the TLS and DTLS IANA registries made in RFC 8447. It adds a new value, \"D\" for discouraged, to the \"Recommended\" column of the selected TLS registries and adds a \"Comment\" column to all active registries that do not already have a \"Comment\" column. Finally, it updates the registration request instructions.\n\n This document updates RFC 8447.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 153030, "intended_std_level": null, "keywords": "[]", "name": "rfc9847", "note": "", "notify": "", "pages": 15, "resource_uri": "/api/v1/doc/document/rfc9847/", "rev": "", "rfc": "9847", "rfc_number": 9847, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:20:08Z", "title": "IANA Registry Updates for TLS and DTLS", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
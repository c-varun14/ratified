{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies authentication-only ciphersuites (with no encryption) for the Pre-Shared Key (PSK) based Transport Layer Security (TLS) protocol.  These ciphersuites are useful when authentication and integrity protection is desired, but confidentiality is not needed or not permitted. [STANDARDS-TRACK]", "ad": "/api/v1/person/person/5376/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 126700, "intended_std_level": null, "keywords": "['cipher suite']", "name": "rfc4785", "note": "", "notify": "", "pages": 5, "resource_uri": "/api/v1/doc/document/rfc4785/", "rev": "", "rfc": "4785", "rfc_number": 4785, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:31:20Z", "title": "Pre-Shared Key (PSK) Ciphersuites with NULL Encryption for Transport Layer Security (TLS)", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 1163}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document defines three hybrid key agreement mechanisms for TLS 1.3 -- X25519MLKEM768, SecP256r1MLKEM768, and SecP384r1MLKEM1024 -- that combine the post-quantum ML-KEM (Module-Lattice-Based Key Encapsulation Mechanism) with an ECDHE (Ephemeral Elliptic Curve Diffie-Hellman) exchange.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 160316, "intended_std_level": null, "keywords": "['ECDH', 'ECDHE', 'hybrid', 'ML-KEM', 'post-quantum', 'x25519']", "name": "rfc10024", "note": "", "notify": "", "pages": 9, "resource_uri": "/api/v1/doc/document/rfc10024/", "rev": "", "rfc": "10024", "rfc_number": 10024, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-08-10T18:11:17Z", "title": "Post-Quantum Traditional (PQ/T) Hybrid Key Agreement Mechanisms for TLS 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
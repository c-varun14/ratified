oup/group/1326/", "id": 295160, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ctls", "note": "", "notify": "caw@heapingbits.net", "pages": 17, "resource_uri": "/api/v1/doc/dochistory/295160/", "rev": "04", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2021-10-25T13:52:35Z", "title": "Compact TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies a \"compact\" version of TLS 1.3.  It is\n   isomorphic to TLS 1.3 but saves space by trimming obsolete material,\n   tighter encoding, a template-based specialization technique, and\n   alternative cryptographic techniques. cTLS is not directly\n   interoperable with TLS 1.3, but it should eventually be possible for\n   a cTLS/TLS 1.3 server to exist and successfully interoperate.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ctls/", "expires": "2022-09-08T19:10:55Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 302814, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ctls", "note": "", "notify": "caw@heapingbits.net", "pages": 18, "resource_uri": "/api/v1/doc/dochistory/302814/", "rev": "05", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2022-03-07T20:10:55Z", "title": "Compact TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies a \"compact\" version of TLS and DTLS.  It is\n   logically isomorphic to ordinary TLS, but saves space by trimming\n   obsolete material, tighter encoding, a template-based specialization\n   technique, and alternative cryptographic techniques. cTLS is not\n   directly interoperable with TLS or DTLS, but it should eventually be\n   possible for a single server port to offer cTLS alongside TLS or\n   DTLS.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ctls/", "expires": "2023-01-10T22:32:07Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 310194, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ctls", "note": "", "notify": "caw@heapingbits.net", "pages": 24, "resource_uri": "/api/v1/doc/dochistory/310194/", "rev": "06", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2022-07-09T21:32:07Z", "title": "Compact TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies a \"compact\" version of TLS and DTLS.  It is\n   logically isomorphic to ordinary TLS, but saves space by trimming\n   obsolete material, tighter encoding, a template-based specialization\n   technique, and alternative cryptographic techniques. cTLS is not\n   directly interoperable with TLS or DTLS, but it should eventually be\n   possible for a single server port to offer cTLS alongside TLS or\n   DTLS.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ctls/", "expires": "2023-07-07T16:58:08Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 322714, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ctls", "note": "", "notify": "caw@heapingbits.net", "pages": 25, "resource_uri": "/api/v1/doc/dochistory/322714/", "rev": "07", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2023-01-03T16:58:08Z", "title": "Compact TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies a \"compact\" version of TLS 1.3 and DTLS 1.3.\n   It saves bandwidth by trimming obsolete material, tighter encoding, a\n   template-based specialization technique, and alternative\n   cryptographic techniques. cTLS is not directly interoperable with TLS\n   1.3 or DTLS 1.3 since the over-the-wire framing is different.  A\n   single server can, however, offer cTLS alongside TLS or DTLS.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ctls/", "expires": "2023-09-14T22:29:41Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 327225, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ctls", "note": "", "notify": "caw@heapingbits.net", "pages": 24, "resource_uri": "/api/v1/doc/dochistory/327225/", "rev": "08", "rfc_number": null, "shepherd": "/api/v1/person/email/caw@heapingbits.net/", "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2023-03-13T22:29:41Z", "title": "Compact TLS 1.3", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document specifies a \"compact\" version of TLS 1.3 and DTLS 1.3.\n   It saves bandwidth by trimming obsolete material, tighter encoding, a\n   template-based specialization technique, and alternative\n   cryptographic techniques. cTLS is not directly interoperable with TLS\n   1.3 or DTLS 1.3 since the over-the-wire framing is different.  A\n   single server can, however, offer cTLS alongside TLS or DTLS.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ctls/", "expires": "2024-10-19T12:45:11Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 373903, "
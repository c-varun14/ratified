{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document specifies a Return Routability Check (RRC) subprotocol for use in the context of the Connection ID (CID) construct for the Datagram Transport Layer Security (DTLS) protocol versions 1.2 and 1.3.\n\n Implementations offering the CID functionality described in RFCs 9146 and 9147 are encouraged to also provide the RRC functionality described in this document. For this reason, this document updates RFCs 9146 and 9147.", "ad": "/api/v1/person/person/112723/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 154244, "intended_std_level": null, "keywords": "['DTLS', 'RRC', 'CID']", "name": "rfc9853", "note": "", "notify": "", "pages": 22, "resource_uri": "/api/v1/doc/document/rfc9853/", "rev": "", "rfc": "9853", "rfc_number": 9853, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:45:56Z", "title": "Return Routability Check for DTLS 1.2 and 1.3", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
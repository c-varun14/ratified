{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "The MD5 and SHA-1 hashing algorithms are increasingly vulnerable to attack, and this document deprecates their use in TLS 1.2 and DTLS 1.2 digital signatures.  However, this document does not deprecate SHA-1 with Hashed Message Authentication Code (HMAC), as used in record protection.  This document updates RFC 5246.", "ad": "/api/v1/person/person/105815/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130956, "intended_std_level": null, "keywords": "['tls']", "name": "rfc9155", "note": "", "notify": "", "pages": 5, "resource_uri": "/api/v1/doc/document/rfc9155/", "rev": "", "rfc": "9155", "rfc_number": 9155, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:43:40Z", "title": "Deprecating MD5 and SHA-1 Signature Hashes in TLS 1.2 and DTLS 1.2", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This memo describes how to use Transport Layer Security (TLS) to secure Hypertext Transfer Protocol (HTTP) connections over the Internet.  This memo provides information for the Internet community.", "ad": null, "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 124793, "intended_std_level": null, "keywords": "['hypertext', 'transfer', 'protocol', 'transport', 'layer', 'security']", "name": "rfc2818", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/document/rfc2818/", "rev": "", "rfc": "2818", "rfc_number": 2818, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": ["/api/v1/name/doctagname/errata/"], "time": "2026-05-20T15:26:55Z", "title": "HTTP Over TLS", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": 2308}]}
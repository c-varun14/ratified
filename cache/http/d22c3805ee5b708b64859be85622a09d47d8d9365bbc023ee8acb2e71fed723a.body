{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 33}, "objects": [{"abstract": "   This document describes GREASE (Generate Random Extensions And\n   Sustain Extensibility), a mechanism to prevent extensibility failures\n   in the TLS ecosystem.  It reserves a set of TLS protocol values that\n   may be advertised by clients to ensure servers correctly handle\n   unknown values.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-grease/", "expires": "2017-07-22T21:13:03Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 184747, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-grease", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/dochistory/184747/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2017-01-18T22:13:03Z", "title": "Applying GREASE to TLS Extensibility", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   This document describes GREASE (Generate Random Extensions And\n   Sustain Extensibility), a mechanism to prevent extensibility failures\n   in the TLS ecosystem.  It reserves a set of TLS protocol values that\n   may be advertised by clients to ensure servers correctly handle\n   unknown values.\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-grease/", "expires": "2017-07-22T21:13:03Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 198171, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-grease", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/dochistory/198171/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tag
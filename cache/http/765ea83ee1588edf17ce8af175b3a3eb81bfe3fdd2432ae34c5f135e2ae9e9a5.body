{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "   Authorization support is required for various Internet\r\n   protocols, for example, TLS, CMS and their consumers,\r\n   and others. The X.509 AttributeCertificate provides a\r\n   structure which can form the basis for such services\r\n   [X.509]. This specification defines two profiles (a\r\n   simple one and a 'full' one)  for the use of X.509\r\n   AttributeCertificates to provide such authorization\r\n   services.\r\n", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-ac509prof/", "expires": "1999-03-26T08:00:00Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 124237, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-ac509prof", "note": "", "notify": "", "pages": 11, "resource_uri": "/api/v1/doc/dochistory/124237/", "rev": "00", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "1998-09-22T07:00:00Z", "title": "An Internet AttributeCertificate Profile for Authorization", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
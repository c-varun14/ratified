{"meta": {"limit": 100, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "The TLS handshake requires the use of CPU-intensive public-key algorithms with a considerable overhead in resource-constrained environments or ones such as mainframes where users are charged for CPU time.  This document describes a means of employing TLS using symmetric keys or passwords shared in advance among communicating parties.  No modifications or alterations to the TLS protocol are required for this process.", "ad": null, "doc": "/api/v1/doc/document/draft-ietf-tls-sharedkeys/", "expires": "2004-04-26T07:00:02Z", "external_url": "", "group": "/api/v1/group/group/1326/", "id": 131331, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-tls-sharedkeys", "note": "", "notify": "", "pages": 6, "resource_uri": "/api/v1/doc/dochistory/131331/", "rev": "02", "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "tags": [], "time": "2003-10-24T07:00:00Z", "title": "Use of Shared Keys in the TLS Protocol", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "This document describes the general problem of encrypting the Server Name Identification (SNI) TLS parameter. The proposed solutions hide a hidden service behind a fronting service, only disclosing the SNI of the fronting service to external observers. This document lists known attacks against SNI encryption, discusses the current \"HTTP co-tenancy\" solution, and presents requirements for future TLS-layer solutions.\n\n In practice, it may well be that no solution can meet every requirement and that practical solutions will have to make some compromises.", "ad": "/api/v1/person/person/115214/", "expires": null, "external_url": "", "group": "/api/v1/group/group/1326/", "id": 130550, "intended_std_level": null, "keywords": "[]", "name": "rfc8744", "note": "", "notify": "", "pages": 13, "resource_uri": "/api/v1/doc/document/rfc8744/", "rev": "", "rfc": "8744", "rfc_number": 8744, "shepherd": null, "states": ["/api/v1/doc/state/177/"], "std_level": "/api/v1/name/stdlevelname/inf/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2026-05-20T15:15:16Z", "title": "Issues and Requirements for Server Name Identification (SNI) Encryption in TLS", "type": "/api/v1/name/doctypename/rfc/", "uploaded_filename": "", "words": null}]}